# Secrets and local configuration
.env
.env.*
config.local.*
*.local.json
*.local.yaml
*.local.yml
credentials*.json
smoke_request.json
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / generated web output
node_modules/
.next/

# Model, cache and runtime state
cache/
models/
jobs/
done/
client_jobs/
client_done/

# Ignore all additional/generated data. The two reviewed raw snapshots are
# force-tracked only in the private repository.
data/
data.zip

# Generated/private experiment outputs are excluded by default. A small set of
# reviewed reports and aggregate summaries is force-added to Git intentionally.
artifacts/
export/
server_backup/
review-ui/

# Local historical tracks not required for the reproducible DSPy baseline
readme.md
infra/telelogs-*-sft/
scripts/*
!scripts/exhaustive_review_v11.py
!scripts/generate_reasoning_v13.py
!scripts/generate_reasoning_v14.py

# Miscellaneous local agent/editor state
.claude/
.codex/
.agents/
.DS_Store

# Third-party training corpora (never commit; multi-GB, unverified provenance)
infra/*/adaptlkey_nemotron_data/
infra/*/adaptkey_nemotron_data/
infra/*/thirdparty/
infra/*/adaptkey_nemotron_data/

# Local server-state snapshots (multi-GB rsync mirrors, never commit)
backups/


# Job wrapper dưới infra/ là SOURCE, không phải runtime state: chúng là công thức
# tái lập (vd 50_merge_ckpt700.sh dựng lại bản merge từ adapter). Quy tắc "jobs/"
# ở trên viết cho thư mục hàng đợi ở gốc repo và đã nuốt nhầm cả 79 file này.
!infra/*/jobs/
